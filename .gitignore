# ML-Agents Python / training artifacts
dist/
build/
*.egg-info/
__pycache__/
*.pyc
*.pyo

# OS files
.DS_Store
Thumbs.db

# Upgrade logs (autogenerated)
UpgradeLog*.htm

# Exported EditMode/PlayMode test results (transient artifacts under Assets/)
/[Aa]ssets/[Tt]ests/**/TestResults_*.xml
/[Aa]ssets/[Tt]ests/**/TestResults_*.xml.meta

# Playwright MCP scratch output (snapshots, console logs)
.playwright-mcp/